    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.8.1",
    "base64-js": "^1.5.1",
    "expo": "~57.0.0",
    "expo-audio": "^57.0.5",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "^57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-image-picker": "^57.0.18",
    "expo-media-library": "^57.0.5",
    "react": "19.2.3",
