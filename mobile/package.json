{
  "name": "MemoryApp",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "node ../node_modules/expo/bin/cli start --go",
