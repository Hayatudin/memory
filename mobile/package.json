    "login": "node ../node_modules/expo/bin/cli login",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
