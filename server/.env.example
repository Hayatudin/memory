# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=memory_db

# Better Auth
# Generate a random 32+ character secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_secure_32_char_secret_min_32_chars
BETTER_AUTH_URL=http://localhost:4000

# Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=memory-assets
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL_PREFIX=http://localhost:4000/uploads
